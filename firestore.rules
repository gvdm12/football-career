rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Пользователь может читать только собственный профиль.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Клиентская регистрация всегда создаёт обычный аккаунт.
      // Роль developer назначается владельцем проекта вручную в Firebase Console.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'role',
          'createdAt'
        ])
        && request.resource.data.role == 'player';

      // Клиенту разрешено менять только имя и дату обновления.
      // Поле role, включая developer, менять через приложение нельзя.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt']);

      allow delete: if false;

      // Каждая карьера хранится отдельным документом, чтобы не упираться
      // в лимит размера одного документа профиля Firestore.
      match /careerSlots/{slotId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && slotId in ['1', '2', '3']
          && request.resource.data.keys().hasOnly([
            'slot',
            'careerJson',
            'updatedAt'
          ])
          && request.resource.data.slot is int
          && request.resource.data.slot >= 1
          && request.resource.data.slot <= 3
          && request.resource.data.careerJson is string
          && request.resource.data.careerJson.size() <= 900000;

        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Баланс FC Points, награды и купленные режимы принадлежат UID.
      match /gameData/{documentId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && documentId == 'fcPoints'
          && request.resource.data.keys().hasOnly(['stateJson', 'updatedAt'])
          && request.resource.data.stateJson is string
          && request.resource.data.stateJson.size() <= 200000;

        allow delete: if request.auth != null
          && request.auth.uid == userId
          && documentId == 'fcPoints';
      }
    }
  }
}
